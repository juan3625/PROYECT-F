    USUARIO ||--o{ INGRESO : registra
    USUARIO ||--o{ META_AHORRO : define
    USUARIO ||--o{ PRESTAMO : administra
    USUARIO ||--o{ RECUPERACION_CONTRASENA : solicita
    USUARIO ||--o{ NOTIFICACION_SUSCRIPCION : registra
